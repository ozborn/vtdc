Prefix(obo:=<http://purl.obolibrary.org/obo/>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(dcterms:=<http://purl.org/dc/terms/>)
Prefix(oboInOwl:=<http://www.geneontology.org/formats/oboInOwl#>)

Ontology(<https://purl.obolibrary.org/obo/vtdc/vtdc-edit.owl>
Import(<https://purl.obolibrary.org/obo/vtdc/imports/iao_import.owl>)
Annotation(dcterms:title "Viral Taxon Demarcation Criteria Ontology"@en)
Annotation(dcterms:description "VTDC describes reusable viral taxon demarcation criteria, composite rules, taxon-specific profile types, and classification assessments. Taxonomy, versioned criterion instances, and executable rules are maintained as separate layers."@en)
Annotation(dcterms:creator "John D. Osborne")
Annotation(dcterms:license <https://creativecommons.org/licenses/by/4.0/>)
Annotation(dcterms:source <https://chatgpt.com/share/6abea53f-c988-83ea-a0da-e7af2d6e5ce7>)
Annotation(rdfs:seeAlso <https://ictv.global/about/taxonomy>)
Annotation(rdfs:comment "Development scaffold. VTDC is a proposed namespace, not an OBO Foundry registration. Starter definitions require domain review. No taxon-specific numerical thresholds or executable classification rules are asserted."@en)
Annotation(rdfs:comment "Original VTDC content by John D. Osborne is licensed under CC BY 4.0. Attribute the ontology and original term identifiers, link to the license, and indicate changes. Reused external terms retain their original identifiers and source attribution."@en)
Annotation(oboInOwl:default-namespace "vtdc")

Declaration(AnnotationProperty(dcterms:title))
AnnotationAssertion(rdfs:label dcterms:title "title"@en)
Declaration(AnnotationProperty(dcterms:description))
AnnotationAssertion(rdfs:label dcterms:description "description"@en)
Declaration(AnnotationProperty(dcterms:creator))
AnnotationAssertion(rdfs:label dcterms:creator "creator"@en)
Declaration(AnnotationProperty(dcterms:license))
AnnotationAssertion(rdfs:label dcterms:license "license"@en)
Declaration(AnnotationProperty(dcterms:source))
AnnotationAssertion(rdfs:label dcterms:source "source"@en)
Declaration(AnnotationProperty(oboInOwl:default-namespace))
AnnotationAssertion(rdfs:label oboInOwl:default-namespace "default namespace"@en)
Declaration(AnnotationProperty(<http://purl.org/dc/elements/1.1/contributor>))
AnnotationAssertion(rdfs:label <http://purl.org/dc/elements/1.1/contributor> "contributor"@en)
AnnotationAssertion(rdfs:label <http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral> "plain literal"@en)

Declaration(Class(obo:VTDC_0000001))
AnnotationAssertion(rdfs:label obo:VTDC_0000001 "taxonomic demarcation information entity"@en)
AnnotationAssertion(Annotation(obo:IAO_0000119 <https://chatgpt.com/share/6abea53f-c988-83ea-a0da-e7af2d6e5ce7>) obo:IAO_0000115 obo:VTDC_0000001 "An information content entity that specifies or records criteria, rules, or assessments used to distinguish viral taxa or evaluate taxonomic membership."@en)
AnnotationAssertion(obo:IAO_0000117 obo:VTDC_0000001 "John D. Osborne")
AnnotationAssertion(dcterms:creator obo:VTDC_0000001 "John D. Osborne")
SubClassOf(obo:VTDC_0000001 obo:IAO_0000030)

Declaration(Class(obo:VTDC_0000002))
AnnotationAssertion(rdfs:label obo:VTDC_0000002 "viral taxon demarcation criterion"@en)
AnnotationAssertion(Annotation(obo:IAO_0000119 <https://chatgpt.com/share/6abea53f-c988-83ea-a0da-e7af2d6e5ce7>) obo:IAO_0000115 obo:VTDC_0000002 "A taxonomic demarcation information entity that specifies a condition to be evaluated when distinguishing viral taxa or assessing the taxonomic membership of a virus."@en)
AnnotationAssertion(obo:IAO_0000117 obo:VTDC_0000002 "John D. Osborne")
AnnotationAssertion(dcterms:creator obo:VTDC_0000002 "John D. Osborne")
SubClassOf(obo:VTDC_0000002 obo:VTDC_0000001)

Declaration(Class(obo:VTDC_0000003))
AnnotationAssertion(rdfs:label obo:VTDC_0000003 "sequence-based demarcation criterion"@en)
AnnotationAssertion(Annotation(obo:IAO_0000119 <https://chatgpt.com/share/6abea53f-c988-83ea-a0da-e7af2d6e5ce7>) obo:IAO_0000115 obo:VTDC_0000003 "A viral taxon demarcation criterion that uses a property of nucleotide or amino acid sequences or a relationship inferred from those sequences."@en)
AnnotationAssertion(obo:IAO_0000117 obo:VTDC_0000003 "John D. Osborne")
AnnotationAssertion(dcterms:creator obo:VTDC_0000003 "John D. Osborne")
SubClassOf(obo:VTDC_0000003 obo:VTDC_0000002)

Declaration(Class(obo:VTDC_0000004))
AnnotationAssertion(rdfs:label obo:VTDC_0000004 "sequence identity demarcation criterion"@en)
AnnotationAssertion(Annotation(obo:IAO_0000119 <https://chatgpt.com/share/6abea53f-c988-83ea-a0da-e7af2d6e5ce7>) obo:IAO_0000115 obo:VTDC_0000004 "A sequence-based demarcation criterion that uses the proportion of identical residues at compared positions in a specified sequence comparison."@en)
AnnotationAssertion(obo:IAO_0000117 obo:VTDC_0000004 "John D. Osborne")
AnnotationAssertion(dcterms:creator obo:VTDC_0000004 "John D. Osborne")
SubClassOf(obo:VTDC_0000004 obo:VTDC_0000003)

Declaration(Class(obo:VTDC_0000005))
AnnotationAssertion(rdfs:label obo:VTDC_0000005 "nucleotide sequence identity demarcation criterion"@en)
AnnotationAssertion(Annotation(obo:IAO_0000119 <https://chatgpt.com/share/6abea53f-c988-83ea-a0da-e7af2d6e5ce7>) obo:IAO_0000115 obo:VTDC_0000005 "A sequence identity demarcation criterion that compares nucleotide residues."@en)
AnnotationAssertion(obo:IAO_0000117 obo:VTDC_0000005 "John D. Osborne")
AnnotationAssertion(dcterms:creator obo:VTDC_0000005 "John D. Osborne")
SubClassOf(obo:VTDC_0000005 obo:VTDC_0000004)

Declaration(Class(obo:VTDC_0000006))
AnnotationAssertion(rdfs:label obo:VTDC_0000006 "amino acid sequence identity demarcation criterion"@en)
AnnotationAssertion(Annotation(obo:IAO_0000119 <https://chatgpt.com/share/6abea53f-c988-83ea-a0da-e7af2d6e5ce7>) obo:IAO_0000115 obo:VTDC_0000006 "A sequence identity demarcation criterion that compares amino acid residues."@en)
AnnotationAssertion(obo:IAO_0000117 obo:VTDC_0000006 "John D. Osborne")
AnnotationAssertion(dcterms:creator obo:VTDC_0000006 "John D. Osborne")
SubClassOf(obo:VTDC_0000006 obo:VTDC_0000004)

Declaration(Class(obo:VTDC_0000007))
AnnotationAssertion(rdfs:label obo:VTDC_0000007 "evolutionary distance demarcation criterion"@en)
AnnotationAssertion(Annotation(obo:IAO_0000119 <https://chatgpt.com/share/6abea53f-c988-83ea-a0da-e7af2d6e5ce7>) obo:IAO_0000115 obo:VTDC_0000007 "A sequence-based demarcation criterion that uses an estimate of evolutionary divergence between sequences under a specified distance model."@en)
AnnotationAssertion(obo:IAO_0000117 obo:VTDC_0000007 "John D. Osborne")
AnnotationAssertion(dcterms:creator obo:VTDC_0000007 "John D. Osborne")
SubClassOf(obo:VTDC_0000007 obo:VTDC_0000003)

Declaration(Class(obo:VTDC_0000008))
AnnotationAssertion(rdfs:label obo:VTDC_0000008 "gene content demarcation criterion"@en)
AnnotationAssertion(Annotation(obo:IAO_0000119 <https://chatgpt.com/share/6abea53f-c988-83ea-a0da-e7af2d6e5ce7>) obo:IAO_0000115 obo:VTDC_0000008 "A sequence-based demarcation criterion that uses the presence, absence, or composition of genes in compared viral genomes."@en)
AnnotationAssertion(obo:IAO_0000117 obo:VTDC_0000008 "John D. Osborne")
AnnotationAssertion(dcterms:creator obo:VTDC_0000008 "John D. Osborne")
SubClassOf(obo:VTDC_0000008 obo:VTDC_0000003)

Declaration(Class(obo:VTDC_0000009))
AnnotationAssertion(rdfs:label obo:VTDC_0000009 "phylogenetic placement demarcation criterion"@en)
AnnotationAssertion(Annotation(obo:IAO_0000119 <https://chatgpt.com/share/6abea53f-c988-83ea-a0da-e7af2d6e5ce7>) obo:IAO_0000115 obo:VTDC_0000009 "A sequence-based demarcation criterion that uses the position or grouping of a virus in a phylogenetic reconstruction."@en)
AnnotationAssertion(obo:IAO_0000117 obo:VTDC_0000009 "John D. Osborne")
AnnotationAssertion(dcterms:creator obo:VTDC_0000009 "John D. Osborne")
SubClassOf(obo:VTDC_0000009 obo:VTDC_0000003)

Declaration(Class(obo:VTDC_0000010))
AnnotationAssertion(rdfs:label obo:VTDC_0000010 "genome organization demarcation criterion"@en)
AnnotationAssertion(Annotation(obo:IAO_0000119 <https://chatgpt.com/share/6abea53f-c988-83ea-a0da-e7af2d6e5ce7>) obo:IAO_0000115 obo:VTDC_0000010 "A viral taxon demarcation criterion that uses the arrangement, segmentation, or organization of features within a viral genome."@en)
AnnotationAssertion(obo:IAO_0000117 obo:VTDC_0000010 "John D. Osborne")
AnnotationAssertion(dcterms:creator obo:VTDC_0000010 "John D. Osborne")
SubClassOf(obo:VTDC_0000010 obo:VTDC_0000002)

Declaration(Class(obo:VTDC_0000011))
AnnotationAssertion(rdfs:label obo:VTDC_0000011 "virion morphology demarcation criterion"@en)
AnnotationAssertion(Annotation(obo:IAO_0000119 <https://chatgpt.com/share/6abea53f-c988-83ea-a0da-e7af2d6e5ce7>) obo:IAO_0000115 obo:VTDC_0000011 "A viral taxon demarcation criterion that uses structural or morphological characteristics of virions."@en)
AnnotationAssertion(obo:IAO_0000117 obo:VTDC_0000011 "John D. Osborne")
AnnotationAssertion(dcterms:creator obo:VTDC_0000011 "John D. Osborne")
SubClassOf(obo:VTDC_0000011 obo:VTDC_0000002)

Declaration(Class(obo:VTDC_0000012))
AnnotationAssertion(rdfs:label obo:VTDC_0000012 "host range demarcation criterion"@en)
AnnotationAssertion(Annotation(obo:IAO_0000119 <https://chatgpt.com/share/6abea53f-c988-83ea-a0da-e7af2d6e5ce7>) obo:IAO_0000115 obo:VTDC_0000012 "A viral taxon demarcation criterion that uses the set or types of hosts a virus can infect."@en)
AnnotationAssertion(obo:IAO_0000117 obo:VTDC_0000012 "John D. Osborne")
AnnotationAssertion(dcterms:creator obo:VTDC_0000012 "John D. Osborne")
SubClassOf(obo:VTDC_0000012 obo:VTDC_0000002)

Declaration(Class(obo:VTDC_0000013))
AnnotationAssertion(rdfs:label obo:VTDC_0000013 "antigenic demarcation criterion"@en)
AnnotationAssertion(Annotation(obo:IAO_0000119 <https://chatgpt.com/share/6abea53f-c988-83ea-a0da-e7af2d6e5ce7>) obo:IAO_0000115 obo:VTDC_0000013 "A viral taxon demarcation criterion that uses antigenic properties or serological relationships of viruses."@en)
AnnotationAssertion(obo:IAO_0000117 obo:VTDC_0000013 "John D. Osborne")
AnnotationAssertion(dcterms:creator obo:VTDC_0000013 "John D. Osborne")
SubClassOf(obo:VTDC_0000013 obo:VTDC_0000002)

Declaration(Class(obo:VTDC_0000014))
AnnotationAssertion(rdfs:label obo:VTDC_0000014 "ecological demarcation criterion"@en)
AnnotationAssertion(Annotation(obo:IAO_0000119 <https://chatgpt.com/share/6abea53f-c988-83ea-a0da-e7af2d6e5ce7>) obo:IAO_0000115 obo:VTDC_0000014 "A viral taxon demarcation criterion that uses ecological characteristics of a virus, such as its habitat or transmission context."@en)
AnnotationAssertion(obo:IAO_0000117 obo:VTDC_0000014 "John D. Osborne")
AnnotationAssertion(dcterms:creator obo:VTDC_0000014 "John D. Osborne")
SubClassOf(obo:VTDC_0000014 obo:VTDC_0000002)

Declaration(Class(obo:VTDC_0000015))
AnnotationAssertion(rdfs:label obo:VTDC_0000015 "biological property demarcation criterion"@en)
AnnotationAssertion(Annotation(obo:IAO_0000119 <https://chatgpt.com/share/6abea53f-c988-83ea-a0da-e7af2d6e5ce7>) obo:IAO_0000115 obo:VTDC_0000015 "A viral taxon demarcation criterion that uses an experimentally observed biological property of a virus, such as tissue tropism, pathogenicity, or replication behavior."@en)
AnnotationAssertion(obo:IAO_0000117 obo:VTDC_0000015 "John D. Osborne")
AnnotationAssertion(dcterms:creator obo:VTDC_0000015 "John D. Osborne")
SubClassOf(obo:VTDC_0000015 obo:VTDC_0000002)

Declaration(Class(obo:VTDC_0000016))
AnnotationAssertion(rdfs:label obo:VTDC_0000016 "composite demarcation rule"@en)
AnnotationAssertion(Annotation(obo:IAO_0000119 <https://chatgpt.com/share/6abea53f-c988-83ea-a0da-e7af2d6e5ce7>) obo:IAO_0000115 obo:VTDC_0000016 "A taxonomic demarcation information entity that specifies how two or more demarcation criteria or rules are combined to support a taxonomic decision."@en)
AnnotationAssertion(obo:IAO_0000117 obo:VTDC_0000016 "John D. Osborne")
AnnotationAssertion(dcterms:creator obo:VTDC_0000016 "John D. Osborne")
SubClassOf(obo:VTDC_0000016 obo:VTDC_0000001)

Declaration(Class(obo:VTDC_0000017))
AnnotationAssertion(rdfs:label obo:VTDC_0000017 "taxon demarcation profile"@en)
AnnotationAssertion(Annotation(obo:IAO_0000119 <https://chatgpt.com/share/6abea53f-c988-83ea-a0da-e7af2d6e5ce7>) obo:IAO_0000115 obo:VTDC_0000017 "A taxonomic demarcation information entity that specifies the criteria and rules applicable to a stated taxonomic scope and target rank within a stated taxonomy version."@en)
AnnotationAssertion(obo:IAO_0000117 obo:VTDC_0000017 "John D. Osborne")
AnnotationAssertion(dcterms:creator obo:VTDC_0000017 "John D. Osborne")
SubClassOf(obo:VTDC_0000017 obo:VTDC_0000001)

Declaration(Class(obo:VTDC_0000018))
AnnotationAssertion(rdfs:label obo:VTDC_0000018 "taxonomic classification assessment"@en)
AnnotationAssertion(Annotation(obo:IAO_0000119 <https://chatgpt.com/share/6abea53f-c988-83ea-a0da-e7af2d6e5ce7>) obo:IAO_0000115 obo:VTDC_0000018 "A taxonomic demarcation information entity that records the result of evaluating a candidate virus against a demarcation profile, together with the evidence and interpretation supporting that result."@en)
AnnotationAssertion(obo:IAO_0000117 obo:VTDC_0000018 "John D. Osborne")
AnnotationAssertion(dcterms:creator obo:VTDC_0000018 "John D. Osborne")
SubClassOf(obo:VTDC_0000018 obo:VTDC_0000001)

Declaration(Class(obo:VTDC_0000019))
AnnotationAssertion(rdfs:label obo:VTDC_0000019 "conjunctive demarcation rule"@en)
AnnotationAssertion(Annotation(obo:IAO_0000119 <https://chatgpt.com/share/6abea53f-c988-83ea-a0da-e7af2d6e5ce7>) obo:IAO_0000115 obo:VTDC_0000019 "A composite demarcation rule that requires every specified component criterion or rule to be satisfied."@en)
AnnotationAssertion(obo:IAO_0000117 obo:VTDC_0000019 "John D. Osborne")
AnnotationAssertion(dcterms:creator obo:VTDC_0000019 "John D. Osborne")
SubClassOf(obo:VTDC_0000019 obo:VTDC_0000016)

Declaration(Class(obo:VTDC_0000020))
AnnotationAssertion(rdfs:label obo:VTDC_0000020 "disjunctive demarcation rule"@en)
AnnotationAssertion(Annotation(obo:IAO_0000119 <https://chatgpt.com/share/6abea53f-c988-83ea-a0da-e7af2d6e5ce7>) obo:IAO_0000115 obo:VTDC_0000020 "A composite demarcation rule that requires at least one specified component criterion or rule to be satisfied."@en)
AnnotationAssertion(obo:IAO_0000117 obo:VTDC_0000020 "John D. Osborne")
AnnotationAssertion(dcterms:creator obo:VTDC_0000020 "John D. Osborne")
SubClassOf(obo:VTDC_0000020 obo:VTDC_0000016)

# Criterion specifications, rules, and profiles direct an evaluation.
SubClassOf(obo:VTDC_0000002 obo:IAO_0000033)
SubClassOf(obo:VTDC_0000016 obo:IAO_0000033)
SubClassOf(obo:VTDC_0000017 obo:IAO_0000033)
)
